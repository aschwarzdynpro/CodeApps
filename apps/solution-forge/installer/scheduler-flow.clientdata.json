{
  "schemaVersion": "1.0.0.0",
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": { "connectionReferenceLogicalName": "__CONNREF__" },
        "api": { "name": "shared_commondataserviceforapps" }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": { "defaultValue": {}, "type": "Object" },
        "$authentication": { "defaultValue": {}, "type": "SecureObject" }
      },
      "triggers": {
        "Every_5_minutes": {
          "type": "Recurrence",
          "recurrence": { "frequency": "Minute", "interval": 5 }
        }
      },
      "actions": {
        "Get_due_runs": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "ListRecordsWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
            "parameters": {
              "organization": "current",
              "entityName": "pro_transferruns",
              "$select": "pro_transferrunid",
              "$filter": "pro_status_opt eq 867520006 and pro_scheduledfor_dat le @{utcNow()}"
            }
          }
        },
        "For_due": {
          "runAfter": { "Get_due_runs": ["Succeeded"] },
          "type": "Foreach",
          "foreach": "@body('Get_due_runs')?['value']",
          "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
          "actions": {
            "Promote_to_queued": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecordWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                "parameters": {
                  "organization": "current",
                  "entityName": "pro_transferruns",
                  "recordId": "@items('For_due')?['pro_transferrunid']",
                  "item/pro_status_opt": 867520000
                }
              }
            }
          }
        },

        "Get_due_packages": {
          "runAfter": { "For_due": ["Succeeded", "Skipped"] },
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "ListRecordsWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
            "parameters": {
              "organization": "current",
              "entityName": "pro_transferpackages",
              "$select": "pro_transferpackageid,pro_name,pro_targetenvs_str,pro_recurrence_opt,pro_nextrun_dat",
              "$filter": "(pro_recurrence_opt eq 867520001 or pro_recurrence_opt eq 867520002) and statecode eq 0 and pro_nextrun_dat le @{utcNow()}"
            }
          }
        },
        "For_pkg": {
          "runAfter": { "Get_due_packages": ["Succeeded"] },
          "type": "Foreach",
          "foreach": "@body('Get_due_packages')?['value']",
          "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
          "actions": {
            "Queue_run": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "CreateRecordWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                "parameters": {
                  "organization": "current",
                  "entityName": "pro_transferruns",
                  "item/pro_name": "@{concat(items('For_pkg')?['pro_name'], ' — ', formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm'), ' UTC (scheduled)')}",
                  "item/pro_package_ref@odata.bind": "@{concat('/pro_transferpackages(', items('For_pkg')?['pro_transferpackageid'], ')')}",
                  "item/pro_status_opt": 867520000,
                  "item/pro_targetenvs_str": "@{items('For_pkg')?['pro_targetenvs_str']}",
                  "item/pro_dryrun_bit": false
                }
              }
            },
            "Roll_next": {
              "runAfter": { "Queue_run": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecordWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                "parameters": {
                  "organization": "current",
                  "entityName": "pro_transferpackages",
                  "recordId": "@items('For_pkg')?['pro_transferpackageid']",
                  "item/pro_nextrun_dat": "@{addDays(items('For_pkg')?['pro_nextrun_dat'], mul(add(div(sub(ticks(utcNow()), ticks(items('For_pkg')?['pro_nextrun_dat'])), mul(if(equals(items('For_pkg')?['pro_recurrence_opt'], 867520002), 7, 1), 864000000000)), 1), if(equals(items('For_pkg')?['pro_recurrence_opt'], 867520002), 7, 1)))}"
                }
              }
            }
          }
        }
      }
    }
  }
}
