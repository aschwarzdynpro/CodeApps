{
  "schemaVersion": "1.0.0.0",
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": { "connectionReferenceLogicalName": "__CONNREF__" },
        "api": { "name": "shared_commondataserviceforapps" }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": { "defaultValue": {}, "type": "Object" },
        "$authentication": { "defaultValue": {}, "type": "SecureObject" }
      },
      "triggers": {
        "When_a_run_is_queued": {
          "type": "OpenApiConnectionWebhook",
          "runtimeConfiguration": { "concurrency": { "runs": 1 } },
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "pro_transferrun",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "pro_status_opt"
            }
          }
        }
      },
      "actions": {
        "If_not_queued": {
          "runAfter": {},
          "type": "If",
          "expression": "@not(equals(triggerOutputs()?['body/pro_status_opt'], 867520000))",
          "actions": {
            "Skip_run": { "runAfter": {}, "type": "Terminate", "inputs": { "runStatus": "Succeeded" } }
          }
        },

        "Claim_running": {
          "runAfter": { "If_not_queued": ["Succeeded"] },
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecordWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
            "parameters": {
              "organization": "current",
              "entityName": "pro_transferruns",
              "recordId": "@triggerOutputs()?['body/pro_transferrunid']",
              "item/pro_status_opt": 867520001,
              "item/pro_startedon_dat": "@{utcNow()}",
              "item/pro_log_txt": ""
            }
          }
        },

        "Get_envs": {
          "runAfter": { "Claim_running": ["Succeeded"] },
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "ListRecordsWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
            "parameters": {
              "organization": "current",
              "entityName": "pro_environmentconfigs",
              "$select": "pro_key,pro_url"
            }
          }
        },

        "If_no_package": {
          "runAfter": { "Get_envs": ["Succeeded"] },
          "type": "If",
          "expression": "@equals(coalesce(triggerOutputs()?['body/_pro_package_ref_value'],''),'')",
          "actions": {
            "Fail_no_package": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecordWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                "parameters": {
                  "organization": "current",
                  "entityName": "pro_transferruns",
                  "recordId": "@triggerOutputs()?['body/pro_transferrunid']",
                  "item/pro_status_opt": 867520003,
                  "item/pro_finishedon_dat": "@{utcNow()}",
                  "item/pro_summary_str": "Run has no package."
                }
              }
            },
            "Stop_no_package": { "runAfter": { "Fail_no_package": ["Succeeded"] }, "type": "Terminate", "inputs": { "runStatus": "Succeeded" } }
          }
        },

        "Get_entries": {
          "runAfter": { "If_no_package": ["Succeeded"] },
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "ListRecordsWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
            "parameters": {
              "organization": "current",
              "entityName": "pro_transferentries",
              "$select": "pro_transferentryid,pro_name,pro_sourceenv_str,pro_matchmode_opt,pro_matchcolumns_str,pro_primaryidattr_str,pro_order_int,pro_columnplan_txt",
              "$filter": "_pro_package_ref_value eq @{triggerOutputs()?['body/_pro_package_ref_value']} and statecode eq 0",
              "$orderby": "pro_order_int asc"
            }
          }
        },

        "Targets": {
          "runAfter": { "Get_entries": ["Succeeded"] },
          "type": "Compose",
          "inputs": "@if(equals(coalesce(triggerOutputs()?['body/pro_targetenvs_str'],''),''), json('[]'), split(triggerOutputs()?['body/pro_targetenvs_str'],','))"
        },

        "For_entry": {
          "runAfter": { "Targets": ["Succeeded"] },
          "type": "Foreach",
          "foreach": "@body('Get_entries')?['value']",
          "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
          "actions": {
            "Plan": {
              "runAfter": {},
              "type": "Compose",
              "inputs": "@json(if(equals(coalesce(items('For_entry')?['pro_columnplan_txt'],''),''),'{\"s\":[],\"l\":[],\"x\":[]}',items('For_entry')?['pro_columnplan_txt']))"
            },
            "Keycols": {
              "runAfter": { "Plan": ["Succeeded"] },
              "type": "Compose",
              "inputs": "@if(equals(items('For_entry')?['pro_matchmode_opt'],867520001), split(coalesce(items('For_entry')?['pro_matchcolumns_str'],''),','), createArray(items('For_entry')?['pro_primaryidattr_str']))"
            },
            "Find_src": {
              "runAfter": { "Keycols": ["Succeeded"] },
              "type": "Query",
              "inputs": { "from": "@body('Get_envs')?['value']", "where": "@equals(item()?['pro_key'], items('For_entry')?['pro_sourceenv_str'])" }
            },
            "If_entry_invalid": {
              "runAfter": { "Find_src": ["Succeeded"] },
              "type": "If",
              "expression": "@or(or(and(equals(length(outputs('Plan')?['s']),0),equals(length(outputs('Plan')?['l']),0)), equals(length(body('Find_src')),0)), greater(length(outputs('Keycols')),5))",
              "actions": {
                "Get_runlog_e": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "ListRecordsWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                    "parameters": {
                      "organization": "current",
                      "entityName": "pro_transferruns",
                      "$select": "pro_log_txt",
                      "$filter": "pro_transferrunid eq @{triggerOutputs()?['body/pro_transferrunid']}"
                    }
                  }
                },
                "Upd_runlog_e": {
                  "runAfter": { "Get_runlog_e": ["Succeeded"] },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecordWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                    "parameters": {
                      "organization": "current",
                      "entityName": "pro_transferruns",
                      "recordId": "@triggerOutputs()?['body/pro_transferrunid']",
                      "item/pro_log_txt": "@{if(equals(coalesce(first(body('Get_runlog_e')?['value'])?['pro_log_txt'],''),''), concat('[', concat('{\"entry\":', substring(string(createArray(items('For_entry')?['pro_name'])),1,sub(length(string(createArray(items('For_entry')?['pro_name']))),2)), ',\"error\":', substring(string(createArray(if(equals(length(body('Find_src')),0),'source environment key not found in pro_environmentconfig', if(greater(length(outputs('Keycols')),5),'more than 5 match columns are not supported','no column plan — re-save the entry in the hub')))),1,sub(length(string(createArray(if(equals(length(body('Find_src')),0),'source environment key not found in pro_environmentconfig', if(greater(length(outputs('Keycols')),5),'more than 5 match columns are not supported','no column plan — re-save the entry in the hub'))))),2)), ',\"errs\":1}'), ']'), concat(substring(first(body('Get_runlog_e')?['value'])?['pro_log_txt'], 0, sub(length(first(body('Get_runlog_e')?['value'])?['pro_log_txt']),1)), ',', concat('{\"entry\":', substring(string(createArray(items('For_entry')?['pro_name'])),1,sub(length(string(createArray(items('For_entry')?['pro_name']))),2)), ',\"error\":', substring(string(createArray(if(equals(length(body('Find_src')),0),'source environment key not found in pro_environmentconfig', if(greater(length(outputs('Keycols')),5),'more than 5 match columns are not supported','no column plan — re-save the entry in the hub')))),1,sub(length(string(createArray(if(equals(length(body('Find_src')),0),'source environment key not found in pro_environmentconfig', if(greater(length(outputs('Keycols')),5),'more than 5 match columns are not supported','no column plan — re-save the entry in the hub'))))),2)), ',\"errs\":1}'), ']'))}"
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "For_target": {
                    "runAfter": {},
                    "type": "Foreach",
                    "foreach": "@outputs('Targets')",
                    "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
                    "actions": {
                      "Find_tgt": {
                        "runAfter": {},
                        "type": "Query",
                        "inputs": { "from": "@body('Get_envs')?['value']", "where": "@equals(item()?['pro_key'], items('For_target'))" }
                      },
                      "If_tgt_unknown": {
                        "runAfter": { "Find_tgt": ["Succeeded"] },
                        "type": "If",
                        "expression": "@equals(length(body('Find_tgt')),0)",
                        "actions": {
                          "Get_runlog_t": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "ListRecordsWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                              "parameters": {
                                "organization": "current",
                                "entityName": "pro_transferruns",
                                "$select": "pro_log_txt",
                                "$filter": "pro_transferrunid eq @{triggerOutputs()?['body/pro_transferrunid']}"
                              }
                            }
                          },
                          "Upd_runlog_t": {
                            "runAfter": { "Get_runlog_t": ["Succeeded"] },
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecordWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                              "parameters": {
                                "organization": "current",
                                "entityName": "pro_transferruns",
                                "recordId": "@triggerOutputs()?['body/pro_transferrunid']",
                                "item/pro_log_txt": "@{if(equals(coalesce(first(body('Get_runlog_t')?['value'])?['pro_log_txt'],''),''), concat('[', concat('{\"entry\":', substring(string(createArray(items('For_entry')?['pro_name'])),1,sub(length(string(createArray(items('For_entry')?['pro_name']))),2)), ',\"target\":', substring(string(createArray(items('For_target'))),1,sub(length(string(createArray(items('For_target')))),2)), ',\"error\":\"target environment key not found in pro_environmentconfig\",\"errs\":1}'), ']'), concat(substring(first(body('Get_runlog_t')?['value'])?['pro_log_txt'], 0, sub(length(first(body('Get_runlog_t')?['value'])?['pro_log_txt']),1)), ',', concat('{\"entry\":', substring(string(createArray(items('For_entry')?['pro_name'])),1,sub(length(string(createArray(items('For_entry')?['pro_name']))),2)), ',\"target\":', substring(string(createArray(items('For_target'))),1,sub(length(string(createArray(items('For_target')))),2)), ',\"error\":\"target environment key not found in pro_environmentconfig\",\"errs\":1}'), ']'))}"
                              }
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "Call_child": {
                              "runAfter": {},
                              "type": "Workflow",
                              "inputs": {
                                "host": { "workflowReferenceName": "__CHILD_ID__" },
                                "body": {
                                  "entryId": "@{items('For_entry')?['pro_transferentryid']}",
                                  "srcUrl": "@{first(body('Find_src'))?['pro_url']}",
                                  "tgtUrl": "@{first(body('Find_tgt'))?['pro_url']}",
                                  "targetKey": "@{items('For_target')}",
                                  "dryRun": "@coalesce(triggerOutputs()?['body/pro_dryrun_bit'], false)"
                                }
                              }
                            },
                            "Call_ok": { "runAfter": { "Call_child": ["Succeeded"] }, "type": "Compose", "inputs": 1 },
                            "Call_fail": { "runAfter": { "Call_child": ["Failed", "TimedOut"] }, "type": "Compose", "inputs": 1 },
                            "Cell_from_child": {
                              "runAfter": { "Call_ok": ["Succeeded", "Skipped"], "Call_fail": ["Succeeded", "Skipped"] },
                              "type": "Compose",
                              "inputs": "@{if(equals(coalesce(outputs('Call_fail'),0),1), concat('{\"entry\":', substring(string(createArray(items('For_entry')?['pro_name'])),1,sub(length(string(createArray(items('For_entry')?['pro_name']))),2)), ',\"target\":', substring(string(createArray(items('For_target'))),1,sub(length(string(createArray(items('For_target')))),2)), ',\"error\":\"cell execution failed — see the child flow run history\",\"errs\":1}'), coalesce(body('Call_child')?['cell'], '{\"error\":\"child returned no cell\",\"errs\":1}'))}"
                            },
                            "Get_runlog_c": {
                              "runAfter": { "Cell_from_child": ["Succeeded"] },
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "ListRecordsWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                                "parameters": {
                                  "organization": "current",
                                  "entityName": "pro_transferruns",
                                  "$select": "pro_log_txt",
                                  "$filter": "pro_transferrunid eq @{triggerOutputs()?['body/pro_transferrunid']}"
                                }
                              }
                            },
                            "Upd_runlog_c": {
                              "runAfter": { "Get_runlog_c": ["Succeeded"] },
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecordWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                                "parameters": {
                                  "organization": "current",
                                  "entityName": "pro_transferruns",
                                  "recordId": "@triggerOutputs()?['body/pro_transferrunid']",
                                  "item/pro_log_txt": "@{if(equals(coalesce(first(body('Get_runlog_c')?['value'])?['pro_log_txt'],''),''), concat('[', outputs('Cell_from_child'), ']'), concat(substring(first(body('Get_runlog_c')?['value'])?['pro_log_txt'], 0, sub(length(first(body('Get_runlog_c')?['value'])?['pro_log_txt']),1)), ',', outputs('Cell_from_child'), ']'))}"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },

        "Get_final": {
          "runAfter": { "For_entry": ["Succeeded"] },
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "ListRecordsWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
            "parameters": {
              "organization": "current",
              "entityName": "pro_transferruns",
              "$select": "pro_log_txt",
              "$filter": "pro_transferrunid eq @{triggerOutputs()?['body/pro_transferrunid']}"
            }
          }
        },
        "Totals": {
          "runAfter": { "Get_final": ["Succeeded"] },
          "type": "Compose",
          "inputs": {
            "created": "@int(first(split(string(xpath(xml(json(concat('{\"r\":{\"i\":', if(equals(coalesce(first(body('Get_final')?['value'])?['pro_log_txt'],''),''),'[]',first(body('Get_final')?['value'])?['pro_log_txt']), '}}'))), 'sum(//i/created)')),'.')))",
            "updated": "@int(first(split(string(xpath(xml(json(concat('{\"r\":{\"i\":', if(equals(coalesce(first(body('Get_final')?['value'])?['pro_log_txt'],''),''),'[]',first(body('Get_final')?['value'])?['pro_log_txt']), '}}'))), 'sum(//i/updated)')),'.')))",
            "deactivated": "@int(first(split(string(xpath(xml(json(concat('{\"r\":{\"i\":', if(equals(coalesce(first(body('Get_final')?['value'])?['pro_log_txt'],''),''),'[]',first(body('Get_final')?['value'])?['pro_log_txt']), '}}'))), 'sum(//i/deactivated)')),'.')))",
            "deleted": "@int(first(split(string(xpath(xml(json(concat('{\"r\":{\"i\":', if(equals(coalesce(first(body('Get_final')?['value'])?['pro_log_txt'],''),''),'[]',first(body('Get_final')?['value'])?['pro_log_txt']), '}}'))), 'sum(//i/deleted)')),'.')))",
            "errs": "@int(first(split(string(xpath(xml(json(concat('{\"r\":{\"i\":', if(equals(coalesce(first(body('Get_final')?['value'])?['pro_log_txt'],''),''),'[]',first(body('Get_final')?['value'])?['pro_log_txt']), '}}'))), 'sum(//i/errs)')),'.')))"
          }
        },
        "Final_status": {
          "runAfter": { "Totals": ["Succeeded"] },
          "type": "Compose",
          "inputs": "@if(equals(outputs('Totals')?['errs'],0),867520002,if(greater(add(add(outputs('Totals')?['created'],outputs('Totals')?['updated']),add(outputs('Totals')?['deactivated'],outputs('Totals')?['deleted'])),0),867520004,867520003))"
        },
        "Finish_run": {
          "runAfter": { "Final_status": ["Succeeded"] },
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecordWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
            "parameters": {
              "organization": "current",
              "entityName": "pro_transferruns",
              "recordId": "@triggerOutputs()?['body/pro_transferrunid']",
              "item/pro_status_opt": "@outputs('Final_status')",
              "item/pro_finishedon_dat": "@{utcNow()}",
              "item/pro_summary_str": "@{concat(if(equals(coalesce(triggerOutputs()?['body/pro_dryrun_bit'], false), true), 'DRY RUN — would be: ', ''), outputs('Totals')?['created'],' created, ',outputs('Totals')?['updated'],' updated, ',outputs('Totals')?['deactivated'],' deactivated, ',outputs('Totals')?['deleted'],' deleted, ',outputs('Totals')?['errs'],' errors')}"
            }
          }
        },
        "Fail_run": {
          "runAfter": { "For_entry": ["Failed", "TimedOut", "Skipped"] },
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecordWithOrganization", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
            "parameters": {
              "organization": "current",
              "entityName": "pro_transferruns",
              "recordId": "@triggerOutputs()?['body/pro_transferrunid']",
              "item/pro_status_opt": 867520003,
              "item/pro_finishedon_dat": "@{utcNow()}",
              "item/pro_summary_str": "Executor crashed — check the Power Automate run history."
            }
          }
        }
      }
    }
  }
}
